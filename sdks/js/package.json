{
  "name": "@openmasterhub/sdk",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "JavaScript client for the OpenMasterHub local API",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p ../../packages/protocol/tsconfig.build.json && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/client.test.ts src/daemon.test.ts"
  },
  "devDependencies": {
    "@openmasterhub/protocol": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "typescript": "~5.8.3",
    "ws": "^8.18.2"
  }
}
