{
  "Name": "Unofficial MasterHub Device Support",
  "Description": "Unofficial MasterHub Device Support. Starts masterhubd in the background when it is not already listening, then registers the device.",
  "Author": "OpenMasterHub",
  "Version": "0.2.0",
  "PluginUUID": "pl.sotomski.opendeck.openmasterhub",
  "CodePath": "opendeck-masterhub",
  "CodePathLin": "opendeck-masterhub-linux",
  "CodePathMac": "opendeck-masterhub",
  "CodePathWin": "opendeck-masterhub.exe",
  "Icon": "assets/icon",
  "Category": "OpenMasterHub",
  "OS": [
    { "Platform": "linux" },
    { "Platform": "mac", "MinimumVersion": "11.3" },
    { "Platform": "windows", "MinimumVersion": "10" }
  ],
  "Actions": [
    {
      "Icon": "assets/rgb",
      "Name": "RGB color",
      "UUID": "pl.sotomski.opendeck.openmasterhub.rgbcolor",
      "Tooltip": "Set the color of the base and knobs",
      "PropertyInspectorPath": "propertyInspector/set-color.html",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [{ "Image": "assets/color" }]
    },
    {
      "Icon": "assets/rgb",
      "Name": "RGB mode",
      "UUID": "pl.sotomski.opendeck.openmasterhub.rgbmode",
      "Tooltip": "Set a light mode, switch it on and off, or step through the modes",
      "PropertyInspectorPath": "propertyInspector/set-mode.html",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [{ "Image": "assets/rgb" }]
    },
    {
      "Icon": "assets/brightness",
      "Name": "Brightness",
      "UUID": "pl.sotomski.opendeck.openmasterhub.setbrightness",
      "Tooltip": "Change the keypad backlight or the RGB brightness",
      "PropertyInspectorPath": "propertyInspector/set-brightness.html",
      "Controllers": ["Keypad", "Encoder"],
      "Encoder": {
        "TriggerDescription": {
          "Rotate": "Change the brightness by the step"
        }
      },
      "SupportedInMultiActions": true,
      "States": [{ "Image": "assets/brightness" }]
    }
  ],
  "DeviceNamespace": "ma"
}
