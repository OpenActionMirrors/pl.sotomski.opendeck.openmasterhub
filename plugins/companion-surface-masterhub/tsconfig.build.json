{
	"extends": "@companion-module/tools/tsconfig/node26/recommended.json",
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules/**", "src/**/*spec.ts", "src/**/__tests__/*", "src/**/__mocks__/*"],
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"verbatimModuleSyntax": true
	}
}
