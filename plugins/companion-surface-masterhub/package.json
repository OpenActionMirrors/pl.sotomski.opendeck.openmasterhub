{
	"name": "companion-surface-masterhub",
	"version": "0.1.3",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"format": "prettier -w .",
		"package": "pnpm run build && companion-surface-build",
		"build": "rimraf dist && pnpm run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "pnpm run lint:raw .",
		"test": "node --experimental-strip-types --import ./test-register.mjs --test src/layout.spec.ts src/input.spec.ts src/jpeg.spec.ts"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OpenMasterHub/openmasterhub.git"
	},
	"engines": {
		"node": "^26"
	},
	"dependencies": {
		"@companion-surface/base": "~1.4.0",
		"@openmasterhub/protocol": "workspace:*",
		"@openmasterhub/sdk": "workspace:*",
		"jpeg-js": "^0.4.4"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json"
}
