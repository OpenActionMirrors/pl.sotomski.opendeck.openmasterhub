{
	"name": "companion-module-masterhub",
	"version": "0.1.2",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"format": "prettier -w .",
		"package": "pnpm run build && companion-module-build",
		"build": "rimraf dist && pnpm run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "pnpm run lint:raw .",
		"test": "node --experimental-strip-types --import ./test-register.mjs --test src/lighting.spec.ts"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OpenMasterHub/openmasterhub.git"
	},
	"engines": {
		"node": "^26"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"@openmasterhub/protocol": "workspace:*",
		"@openmasterhub/sdk": "workspace:*"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"pnpm exec eslint --fix"
		]
	}
}
