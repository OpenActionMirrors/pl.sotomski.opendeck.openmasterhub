{
  "id": "openmasterhub.volume-knobs",
  "name": "System",
  "version": "0.1.0",
  "description": "System volume, microphone, mute, balance, and opening a website.",
  "entrypoint": "main.py",
  "author": "OpenMasterHub",
  "min_core_version": ">=0.1.0",
  "dependencies": [],
  "permissions": [],
  "hooks": {},
  "actions": {
    "switch_context": {
      "label": "Audio mixer",
      "controls": ["button"],
      "role": "switch_context"
    },
    "master_volume": {
      "label": "Master volume",
      "controls": ["knob", "slider", "big_knob"]
    },
    "master_volume_up": {
      "label": "Master volume +",
      "controls": ["button"]
    },
    "master_volume_down": {
      "label": "Master volume -",
      "controls": ["button"]
    },
    "mic_volume": {
      "label": "Mic volume",
      "controls": ["knob", "slider"]
    },
    "mic_volume_up": {
      "label": "Mic volume +",
      "controls": ["button"]
    },
    "mic_volume_down": {
      "label": "Mic volume -",
      "controls": ["button"]
    },
    "mute": {
      "label": "Mute",
      "controls": ["button"]
    },
    "balance": {
      "label": "Balance",
      "controls": ["knob", "roller"]
    },
    "open_website": {
      "label": "Open website",
      "controls": ["button"],
      "params": [
        {
          "id": "browser",
          "label": "Browser",
          "kind": "choice",
          "default": "default",
          "options": [
            { "id": "default", "label": "Default" },
            { "id": "safari", "label": "Safari" },
            { "id": "chrome", "label": "Google Chrome" },
            { "id": "firefox", "label": "Firefox" }
          ]
        },
        {
          "id": "url",
          "label": "Website URL",
          "kind": "text",
          "default": "https://"
        }
      ]
    }
  },
  "context": {
    "defaults": [
      { "target": { "kind": "knob", "index": 0 }, "action": "master_volume" },
      { "target": { "kind": "knob", "index": 1 }, "action": "mic_volume" },
      { "target": { "kind": "knob", "index": 2 }, "action": "balance" }
    ]
  },
  "activation": [
    {
      "action": "set_led_color",
      "payload": {
        "module": { "model": "M003K", "id": "knobs" },
        "control": "all",
        "r": 40,
        "g": 120,
        "b": 255
      }
    }
  ]
}
